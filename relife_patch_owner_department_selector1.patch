+async def _prompt_owner_department(update, context, staff, action: str) -> bool:
+    """Prompt only on the initial Owner menu press; callback resumes the flow."""
+    if (
+        str(staff.get("Role", "")).strip() != roles.Role.OWNER.value
+        or update.callback_query is not None
+    ):
+        return False
+    context.user_data.pop("_owner_department", None)
+    await update.effective_message.reply_text(
+        "বিভাগ নির্বাচন করুন:", reply_markup=_owner_department_keyboard(action)
+    )
+    return True
+
+
+async def _select_owner_department(update, context) -> str:
+    query = update.callback_query
+    await query.answer()
+    department = query.data.rsplit(":", 1)[-1]
+    if department not in {config.DEPARTMENT_PHYSIO, config.DEPARTMENT_DENTAL}:
+        await query.message.reply_text("❌ সঠিক বিভাগ নির্বাচন করা যায়নি।")
+        return ""
+    context.user_data["_owner_department"] = department
+    sheet_scope.bind_sheet(config.sheet_id_for_department(department))
+    await query.edit_message_text(
+        f"{'🩺' if department == config.DEPARTMENT_PHYSIO else '🦷'} {department} নির্বাচন করা হয়েছে।"
+    )
+    return department
+
+
+async def owner_department_reg_selected(update, context):
