+def _owner_department_keyboard(action: str) -> InlineKeyboardMarkup:
+    return InlineKeyboardMarkup([
+        [InlineKeyboardButton("🩺 Physio (PT)", callback_data=f"ownerdept:{action}:Physio")],
+        [InlineKeyboardButton("🦷 Dental (DT)", callback_data=f"ownerdept:{action}:Dental")],
+    ])
+
